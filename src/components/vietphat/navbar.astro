<style>
  /* Animation for dropdown menu */
  @keyframes dropdown-pop {
    0% {
      transform: translateY(-20px) scale(0.9);
      opacity: 0;
    }
    100% {
      transform: translateY(0) scale(1);
      opacity: 1;
    }
  }

  /* Apply animation to dropdown menu */
  ul[id^="menu-"] {
    animation: dropdown-pop 0.3s ease-out forwards;
    opacity: 0;
    transform: translateY(-20px) scale(0.9);
  }

  /* Show menu on hover */
  /* .group:hover #dropdown-menu {
    display: block;
    opacity: 1;
    transform: translateY(0) scale(1);
  } */

  /* Styling the dropdown trigger */
  /* #dropdown-trigger {
    cursor: pointer;
  } */

  /* Accessibility: For users who prefer reduced motion */
  @media (prefers-reduced-motion: reduce) {
    #ul[id^="menu-"] {
      animation: none;
      transform: none;
    }
  }

.dropdown-toggle span,
.dropdown-toggle i {
  display: flex;
  align-items: center; /* Đảm bảo icon và text căn giữa chính xác */
  line-height: 1;
}

</style>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const dropdownToggles = document.querySelectorAll('.dropdown-toggle');
    const dropdownMenus = document.querySelectorAll('ul[id^="menu-"]');

    let activeMenu: HTMLElement | null = null; // Menu hiện tại đang mở

    // Ẩn tất cả menu
    const closeAllMenus = () => {
      dropdownMenus.forEach((menu) => {
        menu.classList.add('hidden');
      });
      activeMenu = null;
    };

    // Xử lý click nút dropdown
    dropdownToggles.forEach((toggle) => {
      toggle.addEventListener('click', (event) => {
        event.stopPropagation(); // Ngăn việc kích hoạt sự kiện click của document

        const targetMenuId = toggle.getAttribute('data-target');
        const targetMenu = document.getElementById(targetMenuId!);

        if (targetMenu === activeMenu) {
          // Nếu nút bấm hiện tại đang mở menu, thì ẩn menu
          targetMenu?.classList.add('hidden');
          activeMenu = null;
        } else {
          // Đóng tất cả menu trước khi mở cái mới
          closeAllMenus();
          targetMenu?.classList.remove('hidden');
          activeMenu = targetMenu;
        }
      });
    });

    // Ẩn menu khi nhấp ra ngoài
    document.addEventListener('click', () => {
      closeAllMenus();
    });
  });

    // // JavaScript for toggling the mobile menu
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    menuBtn?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
    });
  </script>
  