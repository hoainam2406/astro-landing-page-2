---
import Icon from "node_modules/astro-icon/components/Icon.astro";
import { navLinks } from "src/content/config.ts";
// Lấy đường dẫn hiện tại từ Astro
const currentPath = Astro.url.pathname;
---

<nav
  class="fixed start-0 top-0 z-10 w-full bg-[#0F172A] max-lg:border-b max-lg:border-solid max-lg:border-b-slate-600"
>
  <div class=" mx-auto flex flex-wrap items-center justify-between px-4 py-2 lg:px-16 md:px-8 2xl:px-28">
    <!-- Mobile Menu Icon -->
    <button id="menu-btn" class="text-white text-2xl md:hidden">
      <i class="fa-solid fa-bars"></i>
    </button>
    <a href="/" class="flex items-center space-x-3 rtl:space-x-reverse">
      <img src="/src/icons/frameworks/logo.svg" class="h-8" />
    </a>
    <!-- Nút Icon Tai Nghe -->
    <div class="flex space-x-3 md:order-2 md:space-x-0 rtl:space-x-reverse">
      <a href="/contact">
        <button
          class="flex gap-1 items-center justify-center rounded-full border-[0.95px] border-solid border-slate-600 bg-[#334155] p-2 sm:px-4"
        >
          <!-- <i class="fa-solid fa-headphones  text-[#ffffff] text-xs"></i> -->
          <Icon name="headphones" color={"#ffffff"}  class=" text-xs" />
          
          <span class="text-[#ffffff] text-xs max-md:hidden">Liên hệ với chúng tôi</span>
        </button>
      </a>
    </div>
    <div
      class="hidden w-full items-center justify-between md:order-1 md:flex md:w-auto"
      id="navbar-sticky"
    >
      <ul class="flex space-x-14">
        {
          navLinks.map((link) => {
            if (currentPath === link.href) {
              return (
                // pt-2
                <li key?={link.href} class="">
                  <a href={link.href} class="text-[#ffffff]">
                    {link.name}
                  </a>
                  <div class="pt-3" />
                  <div class="rounded-sm border-2 border-[#ffffff] font-semibold text-white" />
                </li>
              );
            } else {
              return (
                // pb-1 pt-3
                <li key?={link.href} class="">
                  {/* pb-2 pt-2 border-b-2 */}
                  <a href={link.href} class="border-transparent text-[#ffffff]">
                    {link.name}
                  </a>
                </li>
              );
            }
          })
        }
      </ul>
    </div>
  </div>
  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden bg-[#0F172A] md:hidden">
    <ul class="mx-auto flex items-center justify-center space-x-8">
      {
        navLinks.map((link) => {
          if (currentPath === link.href) {
            return (
              <li key?={link.href} class="pt-2">
                <a href={link.href} class="text-[#ffffff]">
                  {link.name}
                </a>
                <div class="pt-1" />
                <div class="rounded-sm border-2 border-[#ffffff] font-semibold text-white" />
              </li>
            );
          } else {
            return (
              <li key?={link.href} class="pb-1 pt-3">
                <a
                  href={link.href}
                  class="border-b-2 border-transparent pb-2 pt-2 text-[#ffffff]"
                >
                  {link.name}
                </a>
              </li>
            );
          }
        })
      }
    </ul>
  </div>
</nav>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const dropdownToggles = document.querySelectorAll(".dropdown-toggle");
    const dropdownMenus = document.querySelectorAll('ul[id^="menu-"]');

    let activeMenu: HTMLElement | null = null; // Menu hiện tại đang mở

    // Ẩn tất cả menu
    const closeAllMenus = () => {
      dropdownMenus.forEach((menu) => {
        menu.classList.add("hidden");
      });
      activeMenu = null;
    };

    // Xử lý click nút dropdown
    dropdownToggles.forEach((toggle) => {
      toggle.addEventListener("click", (event) => {
        event.stopPropagation(); // Ngăn việc kích hoạt sự kiện click của document

        const targetMenuId = toggle.getAttribute("data-target");
        const targetMenu = document.getElementById(targetMenuId!);

        if (targetMenu === activeMenu) {
          // Nếu nút bấm hiện tại đang mở menu, thì ẩn menu
          targetMenu?.classList.add("hidden");
          activeMenu = null;
        } else {
          // Đóng tất cả menu trước khi mở cái mới
          closeAllMenus();
          targetMenu?.classList.remove("hidden");
          activeMenu = targetMenu;
        }
      });
    });

    // Ẩn menu khi nhấp ra ngoài
    document.addEventListener("click", () => {
      closeAllMenus();
    });
  });

  // // JavaScript for toggling the mobile menu
  const menuBtn = document.getElementById("menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");

  menuBtn?.addEventListener("click", () => {
    mobileMenu?.classList.toggle("hidden");
  });
</script>
